# SADT PoC — salin ke backend/.env atau export di shell
# Lebih mudah: cd backend && python scripts/apply_env_preset.py gpu.8gb
# Preset: env/mac.lab.env | gpu.6gb.env | gpu.8gb.env | gpu.12gb.env | gpu.demo-fast.env
# Semua env memakai prefix SADT_

# Network (default loopback — aman untuk lab)
# SADT_API_HOST=127.0.0.1
# SADT_API_PORT=8000
# SADT_UI_PORT=5173

# Android agent loopback response ceiling (1–16 MiB)
# SADT_ANDROID_AGENT_MAX_RESPONSE_MB=4
# Setiap JALANKAN AKUISISI: build APK + selalu install -r ke device (default 1)
# SADT_ANDROID_AGENT_FORCE_REINSTALL=1

# Seed password lab (hanya dipakai saat DB users kosong)
# Ganti sebelum deploy di luar localhost
# SADT_SEED_OPERATOR_PASSWORD=Ops@2026
# SADT_SEED_ANALIS_PASSWORD=Analis@2026
# SADT_SEED_PIMPINAN_PASSWORD=Pimpinan@2026
# SADT_SEED_ADMIN_PASSWORD=Admin@2026

# Upload ZIP hasil ADB (analisa tanpa akuisisi live)
# SADT_ZIP_ENABLED=1
# SADT_ZIP_MAX_MB=512

# ---- Preset: Mac lab (CPU) ----
# SADT_OCR_ENABLED=1
# SADT_OCR_BACKEND=easyocr
# SADT_OCR_GPU=0
# Social screenshots are OCR-processed by the backend and mirrored outside staging.
# SADT_ANDROID_SOCIAL_HOST_OCR_ENABLED=1
# SADT_ANDROID_SOCIAL_OCR_MAX_EDGE_PX=1280
# SADT_ANDROID_SOCIAL_OCR_MAG_RATIO=1.25
# SADT_ANDROID_SOCIAL_DEBUG_SNAPSHOTS=1
# SADT_ANDROID_SOCIAL_DEBUG_DIR=<siksik>/temp_crawl
# SADT_IOS_SOCIAL_UI_ENABLED=1
# SADT_IOS_AFC_MEDIA_ENABLED=1
# SADT_IOS_AFC_DOCS_ENABLED=1
# SADT_IOS_MEDIA_PULLER_PATH=<siksik>/ios-media-puller
# Full idevicebackup2 (berat; sering OOM di lab) — default off
# SADT_IOS_LIBIMOBILEDEVICE_BACKUP_ENABLED=0
# Selective SMS/iMessage + contacts (backup2 --only); FULL=0 uncapped, QUICK capped
# SADT_IOS_SMS_CONTACTS_ENABLED=1
# SADT_IOS_SMS_QUICK_MESSAGES=200
# SADT_IOS_SMS_FULL_MESSAGES=0
# SADT_IOS_CONTACTS_QUICK=200
# SADT_IOS_CONTACTS_FULL=0
# SADT_IOS_AFC_FULL_MEDIA_COUNT=0
# SADT_IOS_AFC_FULL_DOCS_COUNT=0
# SADT_MEDIA_TEXT_ENABLED=1
# Explicit nudity flag (independent from OCR/GPU stack; default enabled)
# SADT_NUDITY_DETECTION_ENABLED=1
# SADT_NUDITY_VIDEO_FRAMES_QUICK=12
# SADT_NUDITY_VIDEO_FRAMES_FULL=24
# SADT_NUDITY_VIDEO_MIN_POSITIVE_FRAMES=1
# Android non-root trash recovery (QUICK bounded; FULL includes cache residue)
# SADT_ANDROID_RECOVERY_ENABLED=1
# SADT_ANDROID_RECOVERY_QUICK_MAX_ITEMS=25
# SADT_ANDROID_RECOVERY_FULL_MAX_ITEMS=500
# SADT_ANDROID_RECOVERY_QUICK_MAX_BYTES=536870912
# SADT_ANDROID_RECOVERY_FULL_MAX_BYTES=8589934592
# SADT_ANDROID_RECOVERY_MAX_FILE_BYTES=4294967296
# SADT_ANDROID_RECOVERY_QUICK_SCAN_TIMEOUT_S=120
# SADT_ANDROID_RECOVERY_FULL_SCAN_TIMEOUT_S=900
# SADT_ANDROID_RECOVERY_QUERY_TIMEOUT_S=300
# SADT_ANDROID_RECOVERY_TRANSFER_TIMEOUT_S=3600
# SADT_ANDROID_RECOVERY_OUTPUT_LIMIT_BYTES=33554432
# SADT_ANDROID_RECOVERY_MAX_CACHE_SOURCE_BYTES=536870912
# SADT_OCR_FULL_GALLERY=1
# SADT_WORKER_CONCURRENCY=4
# SADT_OCR_MAX_EDGE_PX=1280
# SADT_VIDEO_WHISPER_MAX_DURATION_S=180

# ---- Preset: GPU full (panitia, akurasi) ----
# python run.py --gpu  # set banyak default otomatis
# SADT_OCR_BACKEND=paddleocr
# SADT_OCR_GPU=1
# SADT_IMAGE_CAP_FULL=5000
# SADT_VIDEO_CAP_FULL=0
# SADT_OCR_FULL_GALLERY=1
# SADT_WORKER_CONCURRENCY=6
# SADT_GPU_WHISPER_MODEL=base
# SADT_VIDEO_OVERLAY_KEYFRAMES=5
# SADT_VIDEO_WHISPER_MAX_DURATION_S=300

# ---- Preset: GPU cepat (demo singkat) ----
# SADT_OCR_FULL_GALLERY=0
# SADT_GPU_WHISPER_MODEL=tiny
# SADT_VIDEO_OVERLAY_KEYFRAMES=2
# SADT_VIDEO_WHISPER_MAX_DURATION_S=120
# SADT_IMAGE_CAP_QUICK=800
# SADT_VIDEO_CAP_QUICK=40

# OCR / media teks
# SADT_OCR_LANGS=en
# SADT_GPU_WHISPER_ENABLED=1
# SADT_GPU_WHISPER_LANG=id

# Tuning volume & paralelisme
# SADT_IMAGE_CAP_QUICK=800
# SADT_IMAGE_CAP_FULL=3000
# SADT_VIDEO_CAP_QUICK=80
# SADT_VIDEO_CAP_FULL=0
# SADT_CV_BATCH_SIZE=16
# SADT_OCR_MAX_EDGE_PX=1280
# SADT_VIDEO_WHISPER_MAX_DURATION_S=300

# Full GPU moderation stack (juga diaktifkan oleh: python run.py --gpu)
# SADT_GPU_STACK_ENABLED=0
# SADT_GPU_SAFEWATCH_ENABLED=1
# SADT_GPU_SAFEWATCH_MODEL=
# SADT_GPU_ICM_ENABLED=1
# SADT_GPU_ICM_MODEL=
# SADT_GPU_QWEN_ENABLED=1
# SADT_GPU_QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Acceptance
# SADT_PERF_SLA_MS=120000
# SADT_REQUIRE_GPU=0

# Gmail OAuth (bootstrap akuisisi live Android)
# Web client ID dari Google Cloud Console — dipakai agent saat AccountManager.getAuthToken
# Android OAuth client WAJIB pakai SHA-1 cert APK yang terinstall (bukan SHA-1 random):
#   apksigner verify --print-certs android-agent/app/build/outputs/apk/debug/app-debug.apk
# Debug WSL default: 61:60:96:3A:55:B4:BE:54:4C:8A:51:A8:D1:1C:3D:08:2F:17:FB:9B
# Package: com.siksik.agent
# SADT_GMAIL_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
# SADT_GMAIL_ACQUISITION_ENABLED=1
